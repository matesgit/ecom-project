#################################################################################
### 1. Get or create guest cart
GET http://127.0.0.1:8000/api/cart/

###

### 2. Add perfume ID = 1 to guest cart
POST http://127.0.0.1:8000/api/cart/add/1/
Content-Type: application/json

{}

###

### 3. Update the item — include cookie returned above:
POST http://127.0.0.1:8000/api/cart/update/108/
Content-Type: application/json
Cookie: guest_id=9e534a5d-22a9-4adc-9d2a-ff9f1e265ef0

{
  "quantity": 5
}

###

### 4. Remove item ID = 3
DELETE http://127.0.0.1:8000/api/cart/remove/108/
Cookie: guest_id=9e534a5d-22a9-4adc-9d2a-ff9f1e265ef0

